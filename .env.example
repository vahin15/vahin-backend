# Vahin Connect — Backend Configuration
# Copy this file to .env and fill in your own values for production.
# NEVER commit .env to git — use environment variables in production.

NODE_ENV=development
PORT=8787

# Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# ⚠️ MUST be set via environment variables in production, NEVER hardcoded
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Used in the push service's required "Subject" field — any contact
# email or URL works, it's only seen by browser push services, not users.
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Database (for future PostgreSQL migration)
# DATABASE_URL=postgresql://user:password@localhost:5432/vahin

# Redis (for future caching & sessions)
# REDIS_URL=redis://localhost:6379

# Sentry (error tracking)
# SENTRY_DSN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
