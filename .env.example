# Vahin Connect — Backend Configuration
# Copy this file to .env and fill in your own values for production
# (or set these as environment variables directly in Render's dashboard).
PORT=8787

# ── Required for native ringing (FCM) ────────────────────────────────────
# Without this, calls will NOT ring when the Android app is closed/killed.
#
# How to get it:
#   1. Firebase console → project "unifest-99468" → gear icon → Project settings
#   2. "Service accounts" tab → "Generate new private key" → downloads a JSON file
#   3. Paste the ENTIRE contents of that JSON file as a single-line value below
#      (or base64-encode it first — the server accepts either form)
#
# On Render: Dashboard → your service → Environment → Add Environment Variable
#   Key:   FIREBASE_SERVICE_ACCOUNT_JSON
#   Value: (paste the JSON, or the base64 string)
#
# This same credential also enables Firestore, which the server now uses for
# persistent storage (subscriptions.json used to get wiped on every Render
# free-tier redeploy — Firestore doesn't).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Web Push (VAPID) — fallback while the WebView process is alive ──────
# Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BK0ff9D-ym_kVEhPLM8I0d9gJkrcarp1-I-j1JsYFh_WcTxjRls7f2kOM8TFbK9XjfzXqZ-aeQVnyK1aRLmb_lc
VAPID_PRIVATE_KEY=cuOUHy0XgC6Mulf4ml4u0FseVY8MakVPY03K58JH8pA
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Shared-secret auth (new) ──────────────────────────────────────────────
# Without this, anyone who knows a Vahin ID can POST to /notify and make
# that person's phone ring, or plant a fake FCM token via /register-fcm.
# Set this to any long random string (e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ) and set the EXACT SAME value as the API_SHARED_SECRET constant near the
# top of www/index.html's <script> in the Android app. If left blank here,
# the check is skipped — the app still works, it's just unprotected.
API_SHARED_SECRET=
