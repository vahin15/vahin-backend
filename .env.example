# Vahin Connect — Backend Configuration
# Copy this file to .env and fill in your own values for production.
# (server.js currently has working defaults baked in so it runs out of the box,
#  but you should rotate the VAPID keys before going to production.)

PORT=8787

# Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BK0ff9D-ym_kVEhPLM8I0d9gJkrcarp1-I-j1JsYFh_WcTxjRls7f2kOM8TFbK9XjfzXqZ-aeQVnyK1aRLmb_lc
VAPID_PRIVATE_KEY=cuOUHy0XgC6Mulf4ml4u0FseVY8MakVPY03K58JH8pA

# Used in the push service's required "Subject" field — any contact
# email or URL works, it's only seen by browser push services, not users.
VAPID_SUBJECT=mailto:admin@yourdomain.com
